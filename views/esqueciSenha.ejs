<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar senha - ConectaVida</title>
    <link rel="stylesheet" href="/css/estilos.css" />
  </head>
  <body>
    <main class="auth-shell">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-logo-wrap">
            <img src="/img/logo.jpg" alt="ConectaVida — Ajuda que conecta pessoas" class="auth-logo" />
          </div>
          <span class="auth-badge">Recuperação</span>
          <h1>Esqueci minha senha</h1>
          <p>Digite seu e-mail para receber um link de redefinição de senha.</p>
        </div>

        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <% if (success) { %><p class="success"><%= success %></p><% } %>

        <form action="/esqueci-senha" method="POST" class="auth-form">
          <input type="email" name="email" placeholder="Seu e-mail cadastrado" required />
          <button type="submit" class="btn">Enviar link</button>
        </form>

        <p class="auth-link"><a href="/login">Voltar para login</a></p>
      </div>
    </main>
    <%- include('partials/rodape') %>
  </body>
</html>
