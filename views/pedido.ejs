<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pedido - ConectaVida</title>
    <link rel="stylesheet" href="/css/estilos.css" />
  </head>
  <body>
    <div class="app-shell dashboard-shell">
      <%- include('partials/menuLateral') %>
      <% if (request) { %>
        <main class="content-panel dashboard-content">
          <section class="page-header">
            <div>
              <span class="page-eyebrow">Detalhes</span>
              <h1>Pedido em destaque</h1>
            </div>
            <div class="header-actions">
              <a class="btn btn-secondary" href="/feed">Voltar ao feed</a>
            </div>
          </section>

          <article class="request-detail card">
            <div class="detail-header">
              <div>
                <span class="category-tag"><%= request.category %></span>
                <h1><%= request.title %></h1>
              </div>
              <span class="status-chip <%= request.status === 'em andamento' ? 'status-ongoing' : 'status-open' %>"><%= request.status %></span>
            </div>

            <div class="detail-meta">
              <span class="badge">Bairro: <%= request.city %></span>
              <span class="badge">Categoria: <%= request.category %></span>
              <span class="badge">Status: <%= request.status %></span>
            </div>

            <div class="detail-body">
              <p><strong>Descrição:</strong> <%= request.description %></p>
              <% if (request.photo) { %>
                <p><strong>Foto:</strong></p>
                <img class="request-photo" src="<%= request.photo %>" alt="Foto anexada ao pedido" />
              <% } %>
              <p><strong>Solicitante:</strong> Pessoa que precisa de ajuda</p>

              <% const requestUserId = request.user ? String(request.user._id || request.user) : null; %>
              <% const requestHelperId = request.helper ? String(request.helper._id || request.helper) : null; %>
              <% const currentUserId = user ? String(user._id) : null; %>
              <% const canSeeContact = user && (
                (requestUserId && currentUserId && requestUserId === currentUserId) ||
                (requestHelperId && currentUserId && requestHelperId === currentUserId) ||
                (user.role === 'admin')
              ); %>

              <% if (canSeeContact) { %>
                <p><strong>Telefone:</strong> <%= request.phone %></p>
              <% } else { %>
                <p class="privacy-note">Contato privado: o telefone ficará visível somente para o ajudante responsável.</p>
              <% } %>
            </div>

            <div class="detail-actions">
              <% if (user && user.userType === 'voluntario' && request.status !== 'concluido' && requestUserId && currentUserId && requestUserId !== currentUserId) { %>
                <% if (!request.helper || requestHelperId === currentUserId) { %>
                  <form action="/pedido/<%= request._id %>/quero-ajudar" method="POST">
                    <button type="submit" class="btn">Quero ajudar</button>
                  </form>
                <% } else { %>
                  <span class="badge-pill">Pedido já está sendo acompanhado.</span>
                <% } %>
              <% } else if (!user) { %>
                <span class="badge-pill">Faça login para se voluntariar.</span>
              <% } %>
            </div>
          </article>

          <% if (request.status === 'concluido' && requestUserId && currentUserId && requestUserId === currentUserId) { %>
            <% if (!request.rating) { %>
              <section class="panel-section">
                <article class="card">
                  <div class="mini-topline">
                    <span class="section-kicker">Avaliação</span>
                  </div>
                  <h2>Avaliar ajudante</h2>
                  <form class="auth-form" action="/pedido/<%= request._id %>/avaliar" method="POST">
                    <label class="form-label" for="rating">Avaliação com estrelas</label>
                    <select name="rating" id="rating" required>
                      <option value="1">1 estrela</option>
                      <option value="2">2 estrelas</option>
                      <option value="3">3 estrelas</option>
                      <option value="4">4 estrelas</option>
                      <option value="5">5 estrelas</option>
                    </select>
                    <textarea name="ratingComment" placeholder="Comentário opcional"></textarea>
                    <button type="submit" class="btn">Enviar avaliação</button>
                  </form>
                </article>
              </section>
            <% } else { %>
              <section class="panel-section">
                <article class="card">
                  <div class="mini-topline">
                    <span class="section-kicker">Avaliação</span>
                  </div>
                  <h2>Sua avaliação</h2>
                  <p><strong>Estrelas:</strong> <%= request.rating %></p>
                  <p><strong>Comentário:</strong> <%= request.ratingComment %></p>
                </article>
              </section>
            <% } %>
          <% } %>

          <% if (chatThread) { %>
            <section class="panel-section request-chat-section">
              <div class="section-heading compact-heading">
                <div>
                  <span class="section-kicker">Conversa</span>
                  <h2>Conversa do pedido</h2>
                </div>
              </div>
              <article class="chat-card">
                <div class="chat-list">
                  <% if (chatThread.messages && chatThread.messages.length) { %>
                    <% chatThread.messages.forEach(function(message) { %>
                      <div class="chat-message-row">
                        <span class="chat-author"><%= message.senderName %></span>
                        <span class="chat-text"><%= message.content %></span>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="empty-panel">
                      <h3>Ainda não há mensagens</h3>
                      <p>Comece a conversa com o ajudante ou com quem pediu ajuda.</p>
                    </div>
                  <% } %>
                </div>

                <form class="chat-form request-chat-form" action="/chat" method="POST">
                  <input type="hidden" name="requestId" value="<%= request._id %>" />
                  <label class="input-label" for="messageText">Mensagem</label>
                  <textarea id="messageText" name="message" placeholder="Escreva sua mensagem" required></textarea>
                  <button type="submit" class="btn btn-sm">Enviar</button>
                </form>
              </article>
            </section>
          <% } else { %>
            <section class="panel-section request-chat-section">
              <div class="section-heading compact-heading">
                <div>
                  <span class="section-kicker">Conversa</span>
                  <h2>Conversa do pedido</h2>
                </div>
              </div>
              <article class="chat-card">
                <div class="empty-panel">
                  <h3>Conversa ainda não criada</h3>
                  <p>O chat será liberado quando houver um ajudante assumindo o pedido.</p>
                </div>
              </article>
            </section>
          <% } %>
        </main>
      <% } %>
    </div>

    <%- include('partials/rodape') %>
  </body>
</html>
