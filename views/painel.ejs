<!DOCTYPE html>
<html lang="pt-BR">
  <% const dashboardRequests = typeof trackedRequests === 'undefined' || !Array.isArray(trackedRequests) ? [] : trackedRequests; %>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Início - ConectaVida</title>
    <link rel="stylesheet" href="/css/estilos.css" />
  </head>
  <body>
    <div class="app-shell dashboard-shell">
      <details class="dashboard-menu-disclosure">
        <summary class="dashboard-menu-trigger">
          <svg aria-hidden="true"><use href="#icon-menu"></use></svg>
          <span class="menu-trigger-closed">Menu</span>
          <span class="menu-trigger-open">Fechar menu</span>
        </summary>
        <%- include('partials/menuLateral') %>
      </details>

      <main class="content-panel dashboard-content">
        <section class="welcome-banner">
          <div>
            <span class="welcome-eyebrow"><svg><use href="#icon-spark"></use></svg> Um espaço de cuidado e conexão</span>
            <h1>Que bom ter você por aqui, <%= (user.name || '').split(' ')[0] %>!</h1>
            <p><%= user.userType === 'voluntario' ? 'Sua presença faz diferença. Acompanhe suas ajudas e encontre novas formas de apoiar.' : 'Você não está sozinho(a). Acompanhe seus pedidos e conte com a força da comunidade.' %></p>
          </div>
        </section>

        <section class="summary-strip dashboard-summary" aria-label="Indicadores da comunidade">
          <article class="summary-card primary-metric">
            <span class="summary-icon"><svg><use href="#icon-users"></use></svg></span>
            <span class="summary-label">Pessoas na comunidade</span>
            <strong><%= metrics.users %></strong>
            <small>Pessoas cadastradas na plataforma</small>
          </article>
          <article class="summary-card success-metric">
            <span class="summary-icon"><svg><use href="#icon-heart"></use></svg></span>
            <span class="summary-label">Ajudas concluídas</span>
            <strong><%= metrics.completed %></strong>
            <small>Pedidos marcados como concluídos</small>
          </article>
          <article class="summary-card accent-metric">
            <span class="summary-icon"><svg><use href="#icon-hand-heart"></use></svg></span>
            <span class="summary-label">Pedidos ativos hoje</span>
            <strong><%= metrics.activeToday %></strong>
            <small>Pedidos não concluídos publicados hoje</small>
          </article>
        </section>

        <details class="dashboard-more">
          <summary class="dashboard-more-trigger">
            <span>Ver mais do painel</span>
            <small>Acompanhamento e notificações</small>
            <svg aria-hidden="true"><use href="#icon-arrow"></use></svg>
          </summary>
          <div class="dashboard-more-content">
            <section class="dashboard-lower-grid">
              <article class="dashboard-tracking-card">
                <div class="section-heading dashboard-section-heading">
                  <div>
                    <span class="section-kicker"><%= user.userType === 'voluntario' ? 'Sua jornada de apoio' : 'Seu acompanhamento' %></span>
                    <h2><%= user.userType === 'voluntario' ? 'Ajudas que você acompanha' : 'Seus pedidos recentes' %></h2>
                  </div>
                  <% if (user.userType === 'voluntario') { %>
                    <a class="text-link" href="/relatorio">Ver relatório <svg><use href="#icon-arrow"></use></svg></a>
                  <% } else { %>
                    <a class="text-link" href="/meus-pedidos">Ver todos <svg><use href="#icon-arrow"></use></svg></a>
                  <% } %>
                </div>

                <% if (dashboardRequests.length) { %>
                  <div class="tracking-list">
                    <% dashboardRequests.forEach(function(request) { %>
                      <a class="tracking-item" href="/pedido/<%= request._id %>">
                        <span class="tracking-item-icon"><svg><use href="#icon-hand-heart"></use></svg></span>
                        <span class="tracking-item-copy">
                          <strong><%= request.title %></strong>
                          <small><%= request.category %><% if (request.city) { %> · <%= request.city %><% } %></small>
                        </span>
                        <span class="tracking-item-meta">
                          <span class="tracking-status"><%= request.status %></span>
                          <% if (request.createdAt) { %><time datetime="<%= new Date(request.createdAt).toISOString() %>"><%= new Date(request.createdAt).toLocaleDateString('pt-BR') %></time><% } %>
                        </span>
                      </a>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="tracking-empty">
                    <span class="tracking-empty-icon"><svg><use href="#icon-heart"></use></svg></span>
                    <div>
                      <strong><%= user.userType === 'voluntario' ? 'Sua jornada de apoio começa aqui' : 'Seus pedidos aparecerão por aqui' %></strong>
                      <p><%= user.userType === 'voluntario' ? 'Quando você aceitar um pedido, poderá acompanhar cada etapa neste espaço.' : 'Quando você publicar um pedido, acompanhe as atualizações e o apoio recebido neste espaço.' %></p>
                    </div>
                  </div>
                <% } %>
              </article>

              <aside class="dashboard-action-card">
                <span class="action-card-icon"><svg><use href="<%= user.userType === 'voluntario' ? '#icon-heart' : '#icon-hand-heart' %>"></use></svg></span>
                <span class="section-kicker"><%= user.userType === 'voluntario' ? 'Faça parte' : 'Você pode contar com a gente' %></span>
                <h2><%= user.userType === 'voluntario' ? 'Sempre há alguém precisando de apoio' : 'Um passo de cada vez' %></h2>
                <p><%= user.userType === 'voluntario' ? 'Encontre pedidos próximos e ofereça ajuda no seu tempo.' : 'Compartilhe o que precisa ou conheça histórias e iniciativas da comunidade.' %></p>
                <a class="btn" href="<%= user.userType === 'voluntario' ? '/ajudar' : '/pedir-ajuda' %>">
                  <%= user.userType === 'voluntario' ? 'Encontrar pedidos' : 'Publicar um pedido' %>
                  <svg><use href="#icon-arrow"></use></svg>
                </a>
                <% if (user.userType !== 'voluntario') { %><a class="action-secondary-link" href="/feed">Conhecer a comunidade</a><% } %>
                <span class="action-card-decoration action-decoration-one"></span>
                <span class="action-card-decoration action-decoration-two"></span>
              </aside>
            </section>

            <section class="dashboard-notifications">
              <div class="section-heading dashboard-section-heading">
                <div>
                  <span class="section-kicker">Perto de você</span>
                  <h2>Notificações recentes</h2>
                </div>
                <a class="text-link" href="/notifications">Todas as notificações <svg><use href="#icon-arrow"></use></svg></a>
              </div>

              <% if (notifications.length) { %>
                <div class="notification-list dashboard-notification-list">
                  <% notifications.forEach(function(notification) { %>
                    <% const notificationDate = notification.createdAt ? new Date(notification.createdAt) : null; %>
                    <article class="notification-card dashboard-notification-card<%= notification.read ? '' : ' unread' %>">
                      <span class="notification-icon">
                        <svg><use href="<%= notification.title && notification.title.toLowerCase().includes('mensagem') ? '#icon-message' : (notification.title && notification.title.toLowerCase().includes('pedido') ? '#icon-hand-heart' : '#icon-bell') %>"></use></svg>
                      </span>
                      <span class="notification-copy">
                        <strong><%= notification.title %></strong>
                        <span><%= notification.message %></span>
                      </span>
                      <span class="notification-date">
                        <% if (notificationDate && !Number.isNaN(notificationDate.getTime())) { %>
                          <time datetime="<%= notificationDate.toISOString() %>"><%= notificationDate.toLocaleDateString('pt-BR') %></time>
                        <% } else { %>
                          <span>Data não registrada</span>
                        <% } %>
                      </span>
                    </article>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="notifications-empty">Você ainda não tem notificações. Novas atualizações da comunidade aparecerão aqui.</div>
              <% } %>
            </section>
          </div>
        </details>
      </main>
    </div>

    <%- include('partials/rodape') %>
  </body>
</html>
